{
  "info": {
    "name": "Skill15 JWT RBAC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "employeeToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "Login Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"employee\",\n  \"password\": \"emp123\"\n}"
        },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "Admin Add Without Token",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/admin/add?employeeName=NoTokenUser"
      }
    },
    {
      "name": "Admin Add With Admin Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/admin/add?employeeName=Alice"
      }
    },
    {
      "name": "Admin Delete With Employee Token",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "url": "{{baseUrl}}/admin/delete?employeeId=E101"
      }
    },
    {
      "name": "Employee Profile With Employee Token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "url": "{{baseUrl}}/employee/profile"
      }
    },
    {
      "name": "Employee Profile With Invalid Token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid.jwt.token"
          }
        ],
        "url": "{{baseUrl}}/employee/profile"
      }
    }
  ]
}
